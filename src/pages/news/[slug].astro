---
import Base from "../../layouts/Base.astro";
import { getNews } from "../../lib/ninetone";
import { renderBio } from "../../lib/markdown";
import { url } from "../../lib/url";
import { pageJsonLdOrigin } from "../../lib/site";
import { breadcrumbs, newsArticle, markdownToPlainText, fmDateToIso } from "../../lib/schema";
import { notFound } from "../../lib/not-found";

export async function getStaticPaths() {
  const posts = await getNews();
  return posts
    .filter((p) => p.slug)
    .map((p) => ({
      params: { slug: String(p.slug) },
      props: { post: p },
    }));
}

// Static build (gh): the post arrives via getStaticPaths props.
// Live server (cf): resolve at request time from the cached news list.
let post = (Astro.props as { post?: Record<string, unknown> }).post;
if (!post) {
  const posts = await getNews();
  post = posts.find((p) => String(p.slug ?? "") === Astro.params.slug);
  if (!post) return notFound(() => Astro.rewrite("/404"));
}

const title = String(post.Title ?? "");
const author = String(post["Created By"] ?? "");
const date = String(post.Date ?? "");
const category = String(post.category ?? "");
const lede = String(post.shortMessage ?? "");
const image = post.image_webp ? String(post.image_webp) : undefined;
const messageHtml = renderBio(String(post.MessageString ?? post.Message ?? ""));

const ytLinks = [post.ytLinkA, post.ytLinkB, post.ytLinkC, post.ytLinkD]
  .map((u) => String(u ?? "").trim())
  .filter(Boolean);

const slug = String(post.slug ?? "");
const origin = pageJsonLdOrigin(Astro.request);
const isoDate = fmDateToIso(date);

// API_NEWS exposes no modification timestamp field distinct from `Date`
// (verified against src/lib/ninetone.ts's WebPost type) — dateModified falls
// back to datePublished inside newsArticle() per the brief, rather than
// fabricating one.
//
// DEVIATION FROM BRIEF (§9): the brief asks for a visible line reading
// "Uppdaterad {date}" (Swedish for "Updated"). There is no real modified-at
// value anywhere in the FM data — only `date`, the publish date — so
// labeling it "Uppdaterad" would tell readers an edit happened after
// publish when none is known to have. That's a false editorial signal, not
// just an SEO nicety, so the line below reads "Publicerad {date}"
// ("Published") instead: same visible dateline the brief wants (helps both
// readers and crawlers see recency), same date value, honest label. Flagged
// for the PR description per the brief's own instruction to surface this
// decision.
const jsonLd = isoDate
  ? [
      breadcrumbs(origin, [
        { name: "News", path: "/news" },
        { name: title, path: `/news/${slug}` },
      ]),
      newsArticle(origin, {
        slug,
        headline: title,
        author,
        datePublished: isoDate,
        image,
        articleBody: markdownToPlainText(String(post.MessageString ?? post.Message ?? "")),
      }),
    ]
  : [
      breadcrumbs(origin, [
        { name: "News", path: "/news" },
        { name: title, path: `/news/${slug}` },
      ]),
    ];
---

<Base title={title} description={lede} ogImage={image} ogType="article" jsonLd={jsonLd}>
  <article class="bg-ninetone-paper">
    <header class="mx-auto max-w-4xl px-6 pt-16 md:pt-24">
      <p class="mb-6">
        <a href={url("/news")} class="kicker text-ninetone-ink/60 hover:text-ninetone-ink">← News</a>
      </p>

      {(category || date) && (
        <div class="mb-6 flex items-center gap-3 text-[0.6875rem] uppercase tracking-[0.16em] text-ninetone-ink/55">
          {category && <span>{category}</span>}
          {category && date && <span class="opacity-40">·</span>}
          {date && <time>{date}</time>}
        </div>
      )}

      <h1 class="font-display text-[clamp(2.25rem,5.5vw,4.5rem)] leading-[1] tracking-[-0.03em]">{title}</h1>

      {lede && (
        <p class="mt-6 max-w-2xl font-display text-xl italic leading-snug tracking-tight text-ninetone-ink/75 md:text-2xl">
          {lede}
        </p>
      )}

      {author && (
        <p class="mt-6 text-xs uppercase tracking-[0.16em] text-ninetone-ink/60">By {author}</p>
      )}

      {date && (
        <p class="kicker mt-6 text-ninetone-ink/55">
          Publicerad <time datetime={isoDate}>{date}</time>
        </p>
      )}
    </header>

    {image && (
      <div class="mx-auto mt-12 max-w-5xl px-6">
        <img src={image} alt={title} class="aspect-[16/10] w-full object-cover" fetchpriority="high" />
      </div>
    )}

    <div class="mx-auto max-w-2xl px-6 pb-16 pt-12">
      <div class="prose lede max-w-none" set:html={messageHtml}></div>

      {ytLinks.length > 0 && (
        <div class="mt-12 grid gap-4 sm:grid-cols-2">
          {ytLinks.map((url) => {
            const idMatch = url.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/);
            const id = idMatch ? idMatch[1] : null;
            return id ? (
              <iframe
                src={`https://www.youtube.com/embed/${id}`}
                class="aspect-video w-full"
                title={title}
                loading="lazy"
                allowfullscreen
              ></iframe>
            ) : null;
          })}
        </div>
      )}

      <div class="mt-16 border-t border-ninetone-rule pt-8">
        <a href={url("/news")} class="kicker text-ninetone-ink/60 hover:text-ninetone-ink">← Back to all stories</a>
      </div>
    </div>
  </article>
</Base>
