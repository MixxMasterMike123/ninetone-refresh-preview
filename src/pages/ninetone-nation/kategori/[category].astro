---
import Base from "../../../layouts/Base.astro";
import ArtistCard from "../../../components/ArtistCard.astro";
import { getBookingCategories, getWebPosts } from "../../../lib/ninetone";
import type { BookingCategory } from "../../../lib/ninetone";
import { slugifyTag } from "../../../lib/booking-slug";
import { url } from "../../../lib/url";
import { pageJsonLdOrigin } from "../../../lib/site";
import { collectionPage, faqPage } from "../../../lib/schema";
import { sectionAccent } from "../../../lib/sections";
import { renderBio } from "../../../lib/markdown";

// Empty categories are not generated at all — no page, no sitemap entry, no
// llms.txt line (rule 12 / DESIGN.md). Mirrors the `populatedCategories`
// filter in src/pages/ninetone-nation/booking.astro exactly, so the two
// pages can never disagree about which categories "exist" — this is the
// single reason getStaticPaths only emits one path per category with at
// least one active talent, derived from data, never hardcoded.
export async function getStaticPaths() {
  const categories = await getBookingCategories();
  const populated = categories.filter((c) => c.artists.length > 0);
  return populated.map((c) => ({
    params: { category: slugifyTag(c.tag) },
    props: { category: c },
  }));
}

// Static build (gh): the category arrives via getStaticPaths props.
// Live server (cf): resolve at request time from the cached category list,
// same fallback pattern as src/pages/news/[slug].astro.
let category = (Astro.props as { category?: BookingCategory }).category;
if (!category) {
  const categories = await getBookingCategories();
  category = categories.find(
    (c) => c.artists.length > 0 && slugifyTag(c.tag) === Astro.params.category,
  );
  if (!category) return Astro.rewrite("/404");
}

const accent = sectionAccent.nation;
const categorySlug = slugifyTag(category.tag);

// Optional FAQ block: a WebPosts category literally named "FAQ {tag}" (e.g.
// "FAQ Artist"). getWebPosts() takes an arbitrary category string — no type
// change needed, per the brief. Hidden entirely when absent (rule 12): no
// empty-state copy, no heading, nothing rendered.
const faqSection = await getWebPosts(`FAQ ${category.tag}`);
const faqItems = (faqSection[0]?.blocks ?? [])
  .filter((b) => b.subject && b.message)
  .map((b) => ({ q: b.subject, a: b.message }));
// JSON-LD FAQPage wants plain question/answer text; the visible block below
// renders the same answer as markdown (renderBio), same split as
// WebPostsSection.astro (subject/message -> heading/rich body).
const faqDisplayItems = faqItems.map((item) => ({ q: item.q, html: renderBio(item.a) }));

const origin = pageJsonLdOrigin(Astro.request);
const path = `/ninetone-nation/kategori/${categorySlug}`;

const jsonLd = [
  collectionPage(origin, {
    name: `${category.tag} — Ninetone Nation`,
    path,
    items: category.artists.map((a) => ({ name: a.name, path: `/ninetone-nation/${a.slug}` })),
  }),
  ...(faqItems.length > 0 ? [faqPage(faqItems)] : []),
];
---

<Base
  title={category.tag}
  theme="nation"
  jsonLd={jsonLd}
  description={
    category.description ||
    `${category.tag} bookable through Ninetone Nation — browse the full roster and get in touch to book your event.`
  }
>
  <section class="bg-ninetone-paper">
    <div class="mx-auto max-w-7xl px-6 pb-10 pt-16 md:pb-16 md:pt-24">
      <div class="grid gap-10 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-7 lg:col-span-8">
          <p class="mb-3">
            <a href={url("/ninetone-nation/booking")} class="kicker text-ninetone-ink/60 hover:text-ninetone-ink">
              ← All entertainers
            </a>
          </p>
          <span class="kicker text-ninetone-green-dark">Nation · {category.tag}</span>

          <h1 class="mt-6 max-w-4xl font-display text-[clamp(2.75rem,7vw,6rem)] leading-[0.95] tracking-[-0.035em]">
            {category.tag}
          </h1>

          {category.description && (
            <p class="mt-6 max-w-2xl font-display text-2xl italic leading-snug tracking-tight text-ninetone-ink/75 md:text-3xl">
              {category.description}
            </p>
          )}
        </div>

        <div class="md:col-span-5 md:pt-10 lg:col-span-4">
          <p class="max-w-sm text-[0.9375rem] leading-relaxed text-ninetone-ink/85">
            {category.artists.length} bookable {category.artists.length === 1 ? "talent" : "talents"} in this
            category. Get in touch and we'll help you find the right fit for your event.
          </p>
          <a
            href={url("/ninetone-nation/contact-ninetone-nation")}
            class={`mt-6 inline-flex min-h-11 items-center gap-2 px-5 py-3 text-sm font-semibold ${accent.cta} transition-colors`}
          >
            Book {category.tag.toLowerCase()}
            <span aria-hidden>→</span>
          </a>
        </div>
      </div>

      <div class={`mt-12 h-0.5 w-full ${accent.bg} opacity-80`} aria-hidden></div>
    </div>
  </section>

  <section class="bg-ninetone-paper pb-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
        {category.artists.map((a) => (
          <ArtistCard
            theme="nation"
            name={a.name}
            slug={a.slug}
            blurb={a.blurb}
            image={a.imageSmall ?? a.imageBig}
            tags={[category.tag]}
            ctaLabel="Book"
            highlight={a.highlight}
            socials={a.socials}
          />
        ))}
      </div>
    </div>
  </section>

  {faqItems.length > 0 && (
    <section class="bg-ninetone-paper-warm py-20">
      <div class="mx-auto grid max-w-7xl gap-10 px-6 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-4 md:sticky md:top-28 md:self-start">
          <span class="kicker text-ninetone-green-dark">FAQ</span>
          <h2 class="mt-3 font-display text-4xl leading-[1.05] tracking-tight md:text-5xl">
            Frequently asked.
          </h2>
        </div>
        <div class="md:col-span-8">
          <dl class="divide-y divide-ninetone-rule border-t border-ninetone-rule">
            {faqDisplayItems.map((item) => (
              <div class="py-6">
                <dt class="font-display text-xl leading-tight tracking-tight md:text-2xl">{item.q}</dt>
                <dd class="prose mt-3 max-w-2xl" set:html={item.html} />
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>
  )}
</Base>
