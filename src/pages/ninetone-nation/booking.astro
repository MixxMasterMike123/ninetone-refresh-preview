---
import Base from "../../layouts/Base.astro";
import ArtistCard from "../../components/ArtistCard.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import { getBookingCategories, getWebPostSection } from "../../lib/ninetone";
import { displayTitle } from "../../lib/display-title";
import { pageJsonLdOrigin } from "../../lib/site";
import { collectionPage } from "../../lib/schema";
import { slugifyTag } from "../../lib/booking-slug";
import { url } from "../../lib/url";

// Core content — failures render the error page (never edge-cached) instead
// of a silently-empty booking roster. Transients are absorbed by lib/cache.ts.
const categories = await getBookingCategories();

// Only render categories that have at least one talent — empty
// categories add noise without adding value. The data still
// exists in FM; this is purely a render filter.
const populatedCategories = categories.filter((c) => c.artists.length > 0);

// Section intro copy: pull from WebPosts (same as before).
const webPosts = await getWebPostSection("Ninetone Nation");
const introBody =
  webPosts?.blocks?.find((b) => b.message)?.message ?? "";

const totalArtists = populatedCategories.reduce((n, c) => n + c.artists.length, 0);

const origin = pageJsonLdOrigin(Astro.request);
const jsonLd = collectionPage(origin, {
  name: "Booking — Ninetone Nation",
  path: "/ninetone-nation/booking",
  items: populatedCategories.flatMap((c) =>
    c.artists.map((a) => ({ name: a.name, path: `/ninetone-nation/${a.slug}` })),
  ),
});
---

<Base
  title="Booking"
  theme="nation"
  jsonLd={jsonLd}
  description="Sweden's leading artists, hosts and speakers, available for your event — browse bookable talent by category."
>
  <SectionIntro
    title="Entertainers"
    tagline={displayTitle(webPosts?.title)}
    readMore={introBody}
    theme="nation"
    logo="/images/nationLogo.png"
    logoAlt="Ninetone Nation"
  />

  <section class="bg-ninetone-paper pb-24">
    <div class="mx-auto max-w-7xl px-6">
      {populatedCategories.length > 1 && (
        <nav
          class="mb-12 -mx-6 overflow-x-auto border-b border-ninetone-rule [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          aria-label="Browse by category"
        >
          <ul class="flex items-center gap-1 px-6 pb-3">
            <li class="shrink-0">
              <span class="kicker text-ninetone-green-dark">{totalArtists} bookable</span>
            </li>
            <li class="mx-3 h-4 w-px shrink-0 bg-ninetone-rule" aria-hidden></li>
            {populatedCategories.map((c) => (
              <li class="shrink-0">
                <a
                  href={url(`/ninetone-nation/kategori/${slugifyTag(c.tag)}`)}
                  class="inline-flex items-center gap-2 px-3 py-1.5 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-ninetone-ink/60 transition-colors hover:text-ninetone-ink"
                >
                  {c.tag}
                  <span class="text-ninetone-ink/35">{c.artists.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="space-y-24">
        {populatedCategories.map((c) => (
          <section>
              <header class="mb-10 grid gap-6 md:grid-cols-12 md:gap-16">
                <div class="md:col-span-7">
                  <a
                    href={url(`/ninetone-nation/kategori/${slugifyTag(c.tag)}`)}
                    class="kicker inline-flex items-center gap-2 text-ninetone-green-dark transition-opacity hover:opacity-70"
                  >
                    {c.tag} · {c.artists.length} {c.artists.length === 1 ? "talent" : "talents"}
                    <span aria-hidden>→</span>
                  </a>
                  <h2 class="mt-4 font-display text-[clamp(2rem,5vw,4rem)] leading-[0.95] tracking-[-0.035em]">
                    <a
                      href={url(`/ninetone-nation/kategori/${slugifyTag(c.tag)}`)}
                      class="transition-opacity hover:opacity-70"
                    >
                      {c.tag === "Föreläsare" ? "Föreläsare." :
                       c.tag === "Konferencier" ? "Konferenciers." :
                       c.tag === "Moderator" ? "Moderatorer." :
                       c.tag === "Underhållare" ? "Underhållare." :
                       c.tag === "Influencer" ? "Influencers." :
                       `${c.tag}er.`}
                    </a>
                  </h2>
                </div>
                {c.description && (
                  <p class="md:col-span-5 md:pt-2 text-base leading-relaxed text-ninetone-ink/70">
                    {c.description}
                  </p>
                )}
              </header>

              <div class={`mt-2 h-px w-full bg-ninetone-green opacity-80`} aria-hidden></div>

              <div class="mt-10 grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
                {c.artists.map((a) => (
                  <ArtistCard
                    theme="nation"
                    name={a.name}
                    slug={a.slug}
                    blurb={a.blurb}
                    image={a.imageSmall ?? a.imageBig}
                    imageWidth={a.imageSmall ? 500 : 1000}
                    imageHeight={a.imageSmall ? 500 : 1000}
                    tags={[c.tag]}
                    ctaLabel="Book"
                    highlight={a.highlight}
                    socials={a.socials}
                  />
                ))}
              </div>
            </section>
        ))}
      </div>
    </div>
  </section>
</Base>
