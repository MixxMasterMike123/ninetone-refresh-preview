---
import Base from "../../layouts/Base.astro";
import SplitPortalHero from "../../components/SplitPortalHero.astro";
import WebPostsSection from "../../components/WebPostsSection.astro";
import LatestNewsSection from "../../components/LatestNewsSection.astro";
import { getWebPostSection } from "../../lib/ninetone";

const webPosts = await getWebPostSection("Ninetone Management");
---

<Base
  title="Ninetone Management"
  theme="management"
  description="Backoffice for public people. Ninetone Management builds structure and strategy for Sweden's creators, influencers and public figures."
>
  {/* Page-level H1. Visually hidden because this archetype's identity is
      carried by the portal tiles and the kicker, and DESIGN.md fixes that
      treatment — but the page still needs exactly one heading that names it,
      and it must belong to the PAGE, not to whichever tile happens to render
      first inside a shared component. */}
  <h1 class="sr-only">Ninetone Management</h1>

  <SplitPortalHero
    theme="management"
    kicker="Ninetone Management"
    left={{
      href: "/management/clients",
      label: "Clients",
      blurb: "A roster of Sweden's most extraordinary creators and influencers.",
      bgImage: "/images/clientsBanner-management.png",
    }}
    right={{
      href: "/team",
      label: "The team",
      blurb: "Day-to-day partners — the people building careers alongside our clients.",
      bgImage: "/images/meetTheTeamBanner.png",
    }}
  />
  <WebPostsSection data={webPosts} />
  <LatestNewsSection />
</Base>
