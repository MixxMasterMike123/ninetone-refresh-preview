---
import type { SectionTheme } from "../lib/sections";
import { sectionAccent } from "../lib/sections";
import { url } from "../lib/url";

interface Props {
  /** Theme drives accent color (button + rule). */
  theme?: SectionTheme;
  /** Kicker label above the headline. */
  kicker: string;
  /** Big editorial headline. */
  heading: string;
  /** Optional italic display tagline shown under the heading. */
  tagline?: string;
  /** Lede paragraph. */
  blurb: string;
  /** Optional metric tiles rendered in the left column. */
  metrics?: Array<{ value: string; label: string }>;
  /** Contact-side micro headline. */
  formTitle: string;
  /** Contact-side description. */
  formBlurb?: string;
  /** Accepted for backwards-compatible page calls; not rendered without delivery. */
  fields?: unknown;
  /** Accepted for backwards-compatible page calls; not rendered without delivery. */
  submitLabel?: string;
  /** Direct mailbox used while web-form delivery is unavailable. */
  contactEmail?: string;
}

const {
  theme = "group",
  kicker,
  heading,
  tagline,
  blurb,
  metrics = [],
  formTitle,
  formBlurb,
  contactEmail = "hello@ninetone.com",
} = Astro.props as Props;

const accent = sectionAccent[theme];
---

<section class="bg-ninetone-paper">
  <div class="mx-auto max-w-7xl px-6 pb-16 pt-12 md:pb-24 md:pt-20">
    <div class="grid gap-12 md:grid-cols-12 md:gap-16">
      <!-- Left: editorial intro + metrics -->
      <div class="md:col-span-6">
        <span class={`kicker ${accent.text}`}>{kicker}</span>
        <h1 class="mt-6 font-display text-[clamp(2.5rem,6vw,5rem)] leading-[0.95] tracking-[-0.035em]">
          {heading}
        </h1>
        {tagline && (
          <p class="mt-6 max-w-xl font-display text-2xl italic leading-snug tracking-tight text-ninetone-ink/75 md:text-3xl">
            {tagline}
          </p>
        )}
        <p class="mt-6 max-w-xl text-base leading-relaxed text-ninetone-ink/70 md:text-lg">{blurb}</p>

        {metrics.length > 0 && (
          <dl class="mt-12 grid gap-x-6 gap-y-8 sm:grid-cols-2 md:grid-cols-4">
            {metrics.map((m) => (
              <div>
                <span class={`block h-px w-10 ${accent.bg}`} aria-hidden></span>
                <dd class="mt-3 font-display text-4xl font-medium leading-none tracking-[-0.02em]">{m.value}</dd>
                <dt class="mt-2 font-mono text-[0.625rem] uppercase tracking-[0.12em] text-ninetone-ink/55">{m.label}</dt>
              </div>
            ))}
          </dl>
        )}
      </div>

      <!-- Right: direct-email contact card. The API intentionally returns 503
           until a delivery provider is configured, so do not offer a form
           that can make a visitor think their enquiry was sent. -->
      <div class="md:col-span-6">
        <div class="border border-ninetone-rule bg-ninetone-paper-warm p-6 md:p-8">
          <span class={`kicker ${accent.text}`}>{accent.label}</span>
          <h2 class="mt-3 font-display text-3xl leading-tight tracking-tight md:text-4xl">{formTitle}</h2>
          {formBlurb && (
            <p class="mt-3 text-sm text-ninetone-ink/65">{formBlurb}</p>
          )}

          <div class="mt-8 border-t border-ninetone-rule pt-6">
            <p class="max-w-md text-sm leading-relaxed text-ninetone-ink/65">
              Please email your enquiry directly. Include the details above so the right team can respond.
            </p>
            <a
              href={`mailto:${contactEmail}`}
              class={`mt-6 inline-flex min-h-11 items-center gap-2 px-5 py-3 text-sm font-semibold ${accent.cta} transition-colors`}
            >
              Email {contactEmail} <span aria-hidden>→</span>
            </a>
            <p class="mt-5 text-[0.6875rem] leading-relaxed text-ninetone-ink/55">
              Your email app will open with a new message. Read our <a href={url("/integritet")} class="underline underline-offset-2 hover:text-ninetone-ink">privacy policy</a> for how we handle personal data.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
