/**
 * Cloudflare Worker config for the SITE (server-rendered Astro).
 * The FM image proxy is a separate Worker — see worker-fm-proxy/wrangler.toml.
 *
 * Build first (`npm run build:cf`), then `npx wrangler deploy`.
 * Secrets (never in this file): FM_USER, FM_PASS, SHOPIFY_ADMIN_TOKEN,
 * YOUTUBE_API_KEY, PUBLISH_PASSWORD → set with `npx wrangler secret put <NAME>`.
 * Local run: `npm run preview:cf` reads secrets from .dev.vars (gitignored).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ninetone-site",
  "compatibility_date": "2026-06-01",
  // nodejs_compat also populates process.env from vars/secrets — the env
  // fallback in src/lib/filemaker.ts (and shopify/youtube) relies on it.
  "compatibility_flags": ["nodejs_compat"],
  // Custom entrypoint: re-exports the adapter's `fetch` VERBATIM and adds the
  // publication `scheduled`/`queue` handlers plus the coordinator Durable
  // Object beside it (src/worker-entry.ts). The adapter's own module exports
  // only `{ fetch }`, so there is nowhere else to put them.
  //
  // This is a VITE build input, not a wrangler path: @cloudflare/vite-plugin
  // resolves it as `virtual:cloudflare/user-entry` and emits
  // `export * from <entry>; export default mod.default ?? {}`, which is why a
  // .ts source works, why the adapter's `virtual:astro-cloudflare:config`
  // import still resolves, and why the named DO export survives. At deploy
  // time `.wrangler/deploy/config.json` redirects wrangler to the GENERATED
  // dist/server/wrangler.json, whose `main` is `entry.mjs`.
  //
  // Still do NOT point this at dist output.
  "main": "src/worker-entry.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      // Cache epoch for the tiered edge cache (src/middleware.ts) — bumped by
      // the Publish button (src/pages/api/publish.ts).
      "binding": "CACHE_STATE",
      "id": "9a5e09f3e19240c192104bb7de0f72a1"
    },
    {
      // Astro sessions store — the adapter auto-enables the KV session
      // driver and declares this binding, so it must resolve to a real
      // namespace even though the site doesn't use Astro.session yet.
      "binding": "SESSION",
      "id": "95e1b100fcb945e2aecbe0dc2e090e12"
    },
    {
      // Contact-form submissions (src/pages/api/contact.ts) — source of
      // truth, written before email is attempted. 90-day TTL set per-key.
      "binding": "CONTACT_SUBMISSIONS",
      "id": "8724541e66e647a29022860aa49aca2f"
    }
  ],
  // ---------------------------------------------------------------------
  // Publication flow (translate-before-publish).
  //
  // NOT YET CREATED IN CLOUDFLARE. Every id below is a placeholder; the
  // resources are created with the commands in
  // docs/translation-publication-progress.md at rollout, which is a separate,
  // authorized step. Resource NAMES are fixed so they are findable in the
  // dashboard (the existing CACHE_STATE namespace was unidentifiable among
  // seven and had to be renamed mid-session — that is the mistake this
  // convention exists to avoid).
  //
  // The whole block is commented out so that `npm run build:cf` and
  // `wrangler deploy` keep working against today's account: wrangler fails
  // hard on a queue or namespace that does not exist. Uncomment at rollout,
  // after the create commands have run and the real ids are pasted in.
  //
  // "kv_namespaces" additions (merge into the array above):
  //   { "binding": "PUBLICATION_STATE",    "id": "<ninetone-publication-state>" },
  //   { "binding": "PUBLICATION_RELEASES", "id": "<ninetone-publication-releases>" }
  //
  // "queues": {
  //   "producers": [{ "binding": "TRANSLATION_JOBS", "queue": "ninetone-translation-jobs" }],
  //   "consumers": [{
  //     "queue": "ninetone-translation-jobs",
  //     "max_batch_size": 10,
  //     "max_retries": 3,
  //     "dead_letter_queue": "ninetone-translation-jobs-dlq"
  //   }]
  // },
  //
  // "durable_objects": {
  //   "bindings": [{
  //     "name": "PUBLICATION_COORDINATOR",
  //     "class_name": "NinetonePublicationCoordinator"
  //   }]
  // },
  // "migrations": [
  //   { "tag": "v1", "new_sqlite_classes": ["NinetonePublicationCoordinator"] }
  // ],
  //
  // Cron goes on THIS Worker, not a second one:
  // "triggers": { "crons": ["*/15 * * * *"] },
  //
  // PUBLICATION_SERVING is deliberately ABSENT from "vars". publicationMode()
  // returns "shadow" unless it is exactly "on", so preparation runs and
  // nothing is served from a release until it is set explicitly.
  // ---------------------------------------------------------------------
  "ratelimits": [
    {
      "name": "PUBLISH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      // Contact endpoint rate limit — 5 requests/min per hashed connecting
      // IP, same fail-closed pattern as PUBLISH_RATE_LIMITER above.
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  // Email Sending binding (src/pages/api/contact.ts) — sends division
  // enquiries via env.CONTACT_EMAIL.send(). Requires the `ninetone.com`
  // domain onboarded via `wrangler email sending enable ninetone.com`
  // before sends will succeed; see contact.ts for the from/to addresses.
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "allowed_sender_addresses": ["noreply@ninetone.com"]
    }
  ],
  "vars": {
    // Non-secret runtime config. FM_HOST/FM_DB have code defaults; set here
    // to be explicit. PUBLIC_NOINDEX stays true until launch.
    "FM_HOST": "files.ninetone.com",
    "FM_DB": "Ninetone Group AB"
  },
  "observability": {
    "enabled": true
  }
}
